@@ -203,3 +205,19 @@ open \"{temp_dir}/{exe_name}.app\" --args {cmd_args}"
 ssh_remote_deploy/cleanup_script="#!/usr/bin/env bash
 kill $(pgrep -x -f \"{temp_dir}/{exe_name}.app/Contents/MacOS/{exe_name} {cmd_args}\")
 rm -rf \"{temp_dir}\""
+
+[preset.3]
+
+name="Linux Desktop"
+platform="Linux"
+runnable=true
+export_filter="all_resources"
+include_filter="*.deck"
+exclude_filter="addons/godot-git-plugin/*,tests/*,tools/*,web/*"
+export_path="../visitor-client-desktop/visitor-client.x86_64"
+
+[preset.3.options]
+
+binary_format/architecture="x86_64"
+texture_format/s3tc_bptc=true
+texture_format/etc2_astc=false
